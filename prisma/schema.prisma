generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  login     String   @unique
  password  String
  role      String   @default("client")
  discord   String?
  phone     String?
  category  String?
  avatar    String?
  notes     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  galleries Gallery[]
  favorites Favorite[]
  ratings   Rating[]
  comments  Comment[]
  downloads Download[]
  contacts  Contact[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  type      String   @default("general")
  createdAt DateTime @default(now())

  galleries Gallery[]
}

model Gallery {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  isPrivate   Boolean  @default(false)
  isPublic    Boolean  @default(false)
  password    String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientId   String?
  client     User?     @relation(fields: [clientId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  photos   Photo[]
  comments Comment[]
}

model Photo {
  id          String   @id @default(cuid())
  filename    String
  path        String
  thumbnail   String?
  width       Int?
  height      Int?
  size        Int?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  galleryId String
  gallery   Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  favorites Favorite[]
  downloads Download[]
}

model Event {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  time        String?
  location    String?
  description String?
  banner      String?
  clientId    String?
  createdAt   DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  discord   String?
  personId  String?
  phone     String?
  instagram String?
  message   String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String
  user    User  @relation(fields: [userId], references: [id])
  photoId String
  photo   Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
}

model Download {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String
  user    User  @relation(fields: [userId], references: [id])
  photoId String
  photo   Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
}

model Settings {
  id            String @id @default("main")
  siteName      String @default("DANTE Photography")
  logo          String?
  primaryColor  String @default("#D4AF37")
  watermarkText String @default("DANTE")
  footerText    String @default("DANTE Photography - Fotografia Profissional GTA RP")
  socialDiscord String?
  socialInsta   String?
  contactInfo   String?
}
